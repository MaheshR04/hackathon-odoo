# Dayflow HRMS - Docker Environment Configuration Template

# Server Port
PORT=5000

# Application Environment (production | development)
NODE_ENV=production

# JSON Web Token Secret Key for Session Authentication & Password Encryption Verification
JWT_SECRET=dayflow_production_jwt_secure_key_2026_change_in_prod

# Password Hash Encryption Configuration
BCRYPT_SALT_ROUNDS=10

# Database Storage Directory
DATABASE_FILE_PATH=./server/data/dayflow_db.json

# Default HR Admin Account Configuration (Initial Seed)
DEFAULT_HR_EMAIL=hr@gmail.com
DEFAULT_HR_ROLE=admin
DEFAULT_HR_DEPT=Human Resources
